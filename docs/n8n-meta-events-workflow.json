    {
      "parameters": {
        "jsCode": "// Monta a resposta devolvida ao app.\nconst resolved = $('Resolver dataset e página').first().json;\nconst r = $input.first().json;\nconst status = Number(r.statusCode || 0);\nconst metaBody = r.body || {};\nconst ok = status >= 200 && status < 300 && !metaBody.error;\nreturn [{ json: {\n  ok,\n  datasetId: resolved.datasetId,\n  pageId: resolved.pageId || null,\n  metaResponse: ok ? metaBody : undefined,\n  error: ok ? undefined : ((metaBody.error && (metaBody.error.error_user_msg || metaBody.error.message)) || ('Meta respondeu HTTP ' + status)),\n} }];\n"
      },
