    {
      "parameters": {
        "jsCode": "// Descobre dataset (pixel) e página pelo anúncio; usa a alternativa do payload se o anúncio não devolver.\nfunction findDatasetAndPage(root) {\n  const result = { dataset: [], page: [] };\n  (function walk(obj) {\n    if (obj && typeof obj === 'object') {\n      if (Array.isArray(obj.dataset)) result.dataset.push(...obj.dataset);\n      else if (Array.isArray(obj.fb_pixel)) result.dataset.push(...obj.fb_pixel);\n      if (Array.isArray(obj.page)) result.page.push(...obj.page);\n      for (const k of Object.keys(obj)) if (obj[k] && typeof obj[k] === 'object') walk(obj[k]);\n    }\n  })(root);\n  return result;\n}\n\nconst body = $('Webhook').first().json.body || {};\nconst specs = $input.first().json || {};\nconst found = findDatasetAndPage(specs.body || specs);\n\nconst datasetId = String(found.dataset[0] || body.fallbackDatasetId || '');\nconst pageId = String(found.page[0] || body.fallbackPageId || '');\n\nif (!datasetId) {\n  return [{ json: { ok: false, noDataset: true, error: 'Anúncio sem pixel/dataset de mensagem e cliente sem conjunto de dados alternativo.' } }];\n}\n\nconst event = JSON.parse(JSON.stringify(body.event || {}));\nevent.user_data = event.user_data || {};\nif (pageId) event.user_data.page_id = pageId;\n\nreturn [{ json: { ok: true, datasetId, pageId, event } }];\n"
      },
