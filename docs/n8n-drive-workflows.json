[
  {
    "name": "WA Drive — 1. Listar Pastas",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "wa-drive-1-listar",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "wf1-webhook",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [240, 300]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={\"ok\": true}"
        },
        "id": "wf1-respond",
        "name": "Responder",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [460, 480]
      },
      {
        "parameters": {
          "conditions": {
            "options": { "caseSensitive": false, "typeValidation": "loose" },
            "combinator": "and",
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.data.key.fromMe }}",
                "rightValue": false,
                "operator": { "type": "boolean", "operation": "equals" }
              },
              {
                "id": "c2",
                "leftValue": "={{ $json.data.messageType }}",
                "rightValue": "conversation",
                "operator": { "type": "string", "operation": "equals" }
              },
              {
                "id": "c3",
                "leftValue": "={{ ($json.data.message.conversation || '').toLowerCase().trim() }}",
                "rightValue": "drive",
                "operator": { "type": "string", "operation": "equals" }
              }
            ]
          }
        },
        "id": "wf1-filter",
        "name": "Filtrar Mensagem",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [460, 300]
      },
      {
        "parameters": {
          "resource": "fileFolder",
          "operation": "search",
          "queryString": "'1Z0qw1EsGG_LlClynk8-B8qGAP4kFtKFy' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false",
          "returnAll": true,
          "options": {}
        },
        "id": "wf1-list-folders",
        "name": "Listar Pastas",
        "type": "n8n-nodes-base.googleDrive",
        "typeVersion": 3,
        "position": [680, 300],
        "credentials": {
          "googleDriveOAuth2Api": { "id": "", "name": "Google Drive account" }
        }
      },
      {
        "parameters": {
          "jsCode": "const files = $input.all();\nconst remoteJid = $('Filtrar Mensagem').item.json.data.key.remoteJid;\n\nconst folders = files\n  .map(item => ({ name: item.json.name, id: item.json.id }))\n  .sort((a, b) => a.name.localeCompare(b.name))\n  .map((f, i) => ({ index: i + 1, name: f.name, id: f.id }));\n\nconst listText = folders.map(f => `${f.index}. ${f.name}`).join('\\n');\nconst message = `📁 Selecione a pasta do cliente:\\n\\n${listText}`;\n\nreturn [{ json: { folders, message, remoteJid } }];"
        },
        "id": "wf1-build-list",
        "name": "Montar Lista",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 300]
      },
      {
        "parameters": {
          "resource": "row",
          "operation": "create",
          "tableId": "drive_uploads",
          "dataToSend": "defineBelow",
          "fieldsUi": {
            "fieldValues": [
              { "fieldId": "folders", "fieldValue": "={{ JSON.stringify($json.folders) }}" },
              { "fieldId": "status", "fieldValue": "aguardando_pasta" }
            ]
          }
        },
        "id": "wf1-supabase-insert",
        "name": "Salvar Supabase",
        "type": "n8n-nodes-base.supabase",
        "typeVersion": 1,
        "position": [1120, 300],
        "credentials": {
          "supabaseApi": { "id": "", "name": "Supabase account" }
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://triadcompany-evolution-api.upw28y.easypanel.host/message/sendText/drive",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [{ "name": "apikey", "value": "429683C4C977415CAAFCCE10F7D57E11" }]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ number: $('Montar Lista').item.json.remoteJid, text: $('Montar Lista').item.json.message }) }}",
          "options": {}
        },
        "id": "wf1-send-wa",
        "name": "Enviar Lista WA",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1340, 300]
      }
    ],
    "connections": {
      "Webhook": {
        "main": [
          [{ "node": "Responder", "type": "main", "index": 0 },
           { "node": "Filtrar Mensagem", "type": "main", "index": 0 }]
        ]
      },
      "Filtrar Mensagem": {
        "main": [
          [{ "node": "Listar Pastas", "type": "main", "index": 0 }],
          []
        ]
      },
      "Listar Pastas": {
        "main": [[{ "node": "Montar Lista", "type": "main", "index": 0 }]]
      },
      "Montar Lista": {
        "main": [[{ "node": "Salvar Supabase", "type": "main", "index": 0 }]]
      },
      "Salvar Supabase": {
        "main": [[{ "node": "Enviar Lista WA", "type": "main", "index": 0 }]]
      }
    },
    "active": false,
    "settings": { "executionOrder": "v1" }
  },

