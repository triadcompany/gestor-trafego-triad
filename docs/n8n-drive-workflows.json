        "id": "wf2-has-record",
        "name": "Tem Registro?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [900, 300]
      },
      {
        "parameters": {
          "jsCode": "const msgText = ($('Filtrar Número').item.json.data.message.conversation || '').trim();\nconst escolha = parseInt(msgText);\nconst registro = $('Buscar Registro').item.json;\nconst folders = typeof registro.folders === 'string' ? JSON.parse(registro.folders) : registro.folders;\nconst remoteJid = $('Filtrar Número').item.json.data.key.remoteJid;\n\nif (isNaN(escolha) || escolha < 1 || escolha > folders.length) {\n  return [{ json: { valido: false, total: folders.length, registroId: registro.id, remoteJid } }];\n}\n\nconst pasta = folders.find(f => f.index === escolha);\nreturn [{ json: {\n  valido: true,\n  pastaClienteId: pasta.id,\n  pastaClienteNome: pasta.name,\n  registroId: registro.id,\n  remoteJid\n} }];"
        },
        "id": "wf2-validate",
        "name": "Validar e Selecionar",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1120, 300]
      },
      {
        "parameters": {
          "conditions": {
            "options": { "typeValidation": "loose" },
            "combinator": "and",
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.valido }}",
                "rightValue": true,
                "operator": { "type": "boolean", "operation": "equals" }
              }
            ]
          }
        },
        "id": "wf2-is-valid",
        "name": "Número Válido?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [1340, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://triadcompany-evolution-api.upw28y.easypanel.host/message/sendText/drive",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [{ "name": "apikey", "value": "429683C4C977415CAAFCCE10F7D57E11" }]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ number: $('Validar e Selecionar').item.json.remoteJid, text: '❌ Número inválido. Responda com um número entre 1 e ' + $('Validar e Selecionar').item.json.total + '.' }) }}",
          "options": {}
        },
        "id": "wf2-send-error",
        "name": "Enviar Erro WA",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1560, 480]
      },
      {
        "parameters": {
