          "dataToSend": "defineBelow",
          "fieldsUi": {
            "fieldValues": [
              { "fieldId": "pasta_cliente_id", "fieldValue": "={{ $json.pastaClienteId }}" },
              { "fieldId": "pasta_cliente_nome", "fieldValue": "={{ $json.pastaClienteNome }}" },
              { "fieldId": "status", "fieldValue": "aguardando_video" }
            ]
          }
        },
        "id": "wf2-supabase-update",
        "name": "Atualizar Supabase",
        "type": "n8n-nodes-base.supabase",
        "typeVersion": 1,
        "position": [1560, 300],
        "credentials": {
          "supabaseApi": { "id": "", "name": "Supabase account" }
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://triadcompany-evolution-api.upw28y.easypanel.host/message/sendText/drive",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [{ "name": "apikey", "value": "429683C4C977415CAAFCCE10F7D57E11" }]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ number: $('Validar e Selecionar').item.json.remoteJid, text: '✅ *' + $('Validar e Selecionar').item.json.pastaClienteNome + '* selecionado.\\n\\nAgora envie o vídeo com o nome do carro na legenda.' }) }}",
          "options": {}
        },
        "id": "wf2-send-confirm",
        "name": "Confirmar Seleção WA",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1780, 300]
      }
    ],
    "connections": {
